<?xml version="1.0" encoding="UTF-8"?>
<!--
  Naifu - CEP extension manifest for Adobe Premiere Pro.
  Host "PPRO" = Premiere Pro. Version range kept wide so it loads on 2024/2025/2026.
-->
<ExtensionManifest Version="7.0"
                   ExtensionBundleId="com.naifu.panel"
                   ExtensionBundleVersion="0.2.1"
                   ExtensionBundleName="Naifu"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="com.naifu.panel.main" Version="0.2.1" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- PPRO = Premiere Pro. 2025 is v25.x; range covers nearby versions. -->
      <Host Name="PPRO" Version="[14.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.naifu.panel.main">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <!-- Lets the panel run FFmpeg via Node's child_process (Phase 1). -->
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Naifu</Menu>
          <Geometry>
            <Size>
              <Height>560</Height>
              <Width>360</Width>
            </Size>
            <MinSize>
              <Height>360</Height>
              <Width>300</Width>
            </MinSize>
            <MaxSize>
              <Height>1400</Height>
              <Width>800</Width>
            </MaxSize>
          </Geometry>
          <Icons />
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
